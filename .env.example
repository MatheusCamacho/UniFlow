# ==========================================================
# UniFlow — Variáveis de Ambiente (Modelo para GitHub)
# Ao executar iniciar.bat / iniciar.sh / python start.py,
# o arquivo backend/.env é criado automaticamente a partir
# deste modelo com chaves seguras geradas localmente.
# NUNCA faça commit do arquivo .env com credenciais reais.
# ==========================================================

APP_ENV=development
DEFAULT_TIMEZONE=America/Sao_Paulo

# Geradas automaticamente pelo script de inicialização se deixadas como padrão
APP_SECRET_KEY=gerar_automaticamente
TOKEN_ENCRYPTION_KEY=gerar_automaticamente

# Banco de dados padrão (SQLite local — zero configuração, sem Docker)
# Para usar PostgreSQL em produção, substitua pela URL postgresql+psycopg://...
DATABASE_URL=sqlite:///./uniflow.db

# URLs locais da aplicação
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# Integração 1 — Google Calendar API (OAuth 2.0) — Opcional para iniciar
# Crie em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar.events

# Integração 2 — Webhook de Alertas (Discord / Telegram) — Opcional
ALERT_WEBHOOK_URL=

# Intervalos do Worker de Automação (em minutos)
GOOGLE_SYNC_INTERVAL_MINUTES=5
ICS_SYNC_INTERVAL_MINUTES=30
DEADLINE_CHECK_INTERVAL_MINUTES=5

# Conta inicial criada automaticamente na primeira execução
ADMIN_EMAIL=estudante@uniflow.local
ADMIN_PASSWORD=uniflow123
ADMIN_NAME=Estudante UniFlow
